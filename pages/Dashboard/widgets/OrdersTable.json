    "customColumn4": {
      "alias": "Payment",
      "allowCellWrapping": false,
      "allowSameOptionsInNewRow": true,
      "buttonStyle": "rgb(3, 179, 101)",
      "cellBackground": "",
      "columnType": "text",
      "computedValue": "{{(() => { const tableData = OrdersTable.processedTableData || []; return tableData.length > 0 ? tableData.map((currentRow, currentIndex) => ((() => {\n      const method = String(currentRow.payment_method || '').toUpperCase();\n      if (method === 'COD') return 'Наложен платеж';\n      if (method === 'CARD' || method === 'PAID') return 'Платена онлайн';\n      return '—';\n    })())) : (() => {\n      const method = String(currentRow.payment_method || '').toUpperCase();\n      if (method === 'COD') return 'Наложен платеж';\n      if (method === 'CARD' || method === 'PAID') return 'Платена онлайн';\n      return '—';\n    })() })()}}",
